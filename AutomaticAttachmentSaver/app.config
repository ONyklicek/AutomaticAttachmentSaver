<?xml version="1.0" encoding="utf-8" ?>
<configuration>

    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="AutomaticAttachmentSaver.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="AutomaticAttachmentSaver.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- Tento oddíl definuje konfiguraci protokolování pro My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Pro zápis do protokolu událostí aplikací odkomentujte níže uvedený oddíl -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information" />
        </switches>
        <sharedListeners>
            <add name="FileLog"
                 type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL"
                 initializeData="FileLogWriter"/>
            <!-- Pro zápis do protokolu událostí aplikací odkomentujte níže uvedený oddíl a nahraďte APPLICATION_NAME názvem vaší aplikace -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>

    <userSettings>
        <AutomaticAttachmentSaver.MySettings>
            <setting name="RootPath" serializeAs="String">
                <value />
            </setting>
            <setting name="MonitoredFolders" serializeAs="String">
                <value />
            </setting>
            <setting name="senderAddress" serializeAs="String">
                <value />
            </setting>
            <setting name="searchDirectoryPattern" serializeAs="String">
                <value />
            </setting>
            <setting name="OrderNumberPatternSubject" serializeAs="String">
                <value>\b\d{4}\b</value>
            </setting>
        </AutomaticAttachmentSaver.MySettings>
    </userSettings>
    <applicationSettings>
        <AutomaticAttachmentSaver.MySettings>
            <setting name="AppLinkGithub" serializeAs="String">
                <value>https://github.com/ONyklicek/AutomaticAttachmentSaver</value>
            </setting>
        </AutomaticAttachmentSaver.MySettings>
    </applicationSettings>
</configuration>
